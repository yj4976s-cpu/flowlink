# local development default. In production, set APP_ENV=production and replace
# AI_INTERNAL_API_KEY with the same non-public value used by backend/.env.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001

# production requires at least 32 characters.
AI_INTERNAL_API_KEY=

# Use an untracked team model path. From backend-ai, ../models points to the
# repository-level models directory also mounted into Docker at /app/models.
DETECTION_MODEL=../models/best_v7_8n_100_640_16_SGD_0005.pt
DETECTION_CONFIDENCE=0.25
DETECTION_IMGSZ=640
MODEL_STATE_PATH=state/active-model.json
