# local development default. In production, set APP_ENV=production and replace
# AI_INTERNAL_API_KEY with the same non-public value used by backend/.env.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001

# production requires at least 32 characters.
AI_INTERNAL_API_KEY=

# Local Backend callback target for video progress.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Use an untracked team model path. From backend-ai, ../models points to the
# repository-level models directory also mounted into Docker at /app/models.
DETECTION_MODEL=../models/best_v7_8n_100_640_16_SGD_0005.pt
DETECTION_CONFIDENCE=0.25
DETECTION_IMGSZ=640
TRACK_MIN_APPEARANCES=3
TRACK_MIN_DURATION_MS=500
TRACK_MIN_MEDIAN_CONFIDENCE=0.5
TRACK_MIN_DENSITY=0.5
TRACK_MIN_DOMINANT_CLASS_RATIO=0.7
WEBCAM_TRACK_SESSION_TTL_SECONDS=30
WEBCAM_TRACK_MAX_SESSIONS=100
WEBCAM_TRACK_OBSERVATION_WINDOW=120
WEBCAM_TRACK_MAX_TRACKS=64
WEBCAM_TRACK_STALE_FRAMES=90
MODEL_STATE_PATH=state/active-model.json
