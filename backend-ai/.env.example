# local development default. In production, set APP_ENV=production and replace
# AI_INTERNAL_API_KEY with the same non-public value used by backend/.env.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001

# production requires at least 32 characters.
AI_INTERNAL_API_KEY=

# Use yolo11n.pt for local smoke tests, or point to an untracked team model path
# such as models/best.pt or ../ai/best.pt.
DETECTION_MODEL=yolo11n.pt
DETECTION_CONFIDENCE=0.25
DETECTION_IMGSZ=640
