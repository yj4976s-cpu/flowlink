# Copy this file to .env.production on the deployment host.
# Keep real values out of Git.

APP_ENV=production

# Public URL used by the browser and by backend CORS/cookie settings.
FRONTEND_URL=https://flowlink.example.com
NEXT_PUBLIC_API_BASE_URL=https://flowlink.example.com

# Frontend public browser keys.
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Backend application secrets.
JWT_SECRET_KEY=
AI_INTERNAL_API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_COOKIE_NAME=flowlink_access_token

# Supabase PostgreSQL connection. Do not run PostgreSQL in this compose stack.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Optional Supabase Storage integration. Service role key must stay server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional integrations.
ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT_ID=
ROBOFLOW_MODEL_VERSION=
KAKAO_REST_API_KEY=
CHAT_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
COPILOT_TIMEOUT_SECONDS=30
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
COPILOT_GUEST_RATE_LIMIT=10
COPILOT_USER_RATE_LIMIT=30
COPILOT_ADMIN_RATE_LIMIT=60
COPILOT_MAX_OUTPUT_TOKENS=1200
COPILOT_PROVIDER_COOLDOWN_SECONDS=30

# AI service and model runtime.
DETECTION_MODEL=/app/models/best.pt
DETECTION_CONFIDENCE=0.25
DETECTION_IMGSZ=640
IMAGE_MAX_BYTES=20971520
IMAGE_MAX_PIXELS=16000000
VIDEO_MAX_BYTES=104857600
VIDEO_MAX_DURATION_SECONDS=30
AI_SERVICE_TIMEOUT_SECONDS=30
AI_VIDEO_SERVICE_TIMEOUT_SECONDS=120

# Reverse proxy.
HTTP_PORT=80
