# Copy this file to .env.production on the deployment host.
# Keep real values out of Git.

APP_ENV=production
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Canonical HTTPS origin used by browser redirects and backend validation.
FRONTEND_URL=https://flowlink-project.duckdns.org
# Same-origin deployment should use /api through Nginx.
NEXT_PUBLIC_API_BASE_URL=/api
# Optional public origin for starting OAuth. Leave empty to use same-origin /api.
NEXT_PUBLIC_OAUTH_BASE_URL=
# Public backend origin used for OAuth callbacks. Do not include /api.
OAUTH_BACKEND_BASE_URL=https://flowlink-project.duckdns.org
ALLOWED_FRONTEND_ORIGINS=https://flowlink-project.duckdns.org
AUTH_INSECURE_HTTP_HOSTS=
# Docker-internal reverse-proxy IP from compose.prod.yaml, not the public server IP.
FORWARDED_ALLOW_IPS=172.30.0.10

# Frontend public browser keys.
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Backend application secrets.
JWT_SECRET_KEY=
AI_INTERNAL_API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=flowlink_access_token

# Supabase PostgreSQL connection. Dashboard postgresql:// and postgres:// URIs
# are accepted and normalized by the backend to SQLAlchemy's psycopg 3 dialect.
DATABASE_URL=

# Optional Supabase Storage integration. Service role key must stay server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional integrations.
ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT_ID=
ROBOFLOW_MODEL_VERSION=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Copilot provider.
CHAT_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
COPILOT_TIMEOUT_SECONDS=30
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
COPILOT_GUEST_RATE_LIMIT=10
COPILOT_USER_RATE_LIMIT=30
COPILOT_ADMIN_RATE_LIMIT=60
COPILOT_MAX_OUTPUT_TOKENS=1200
COPILOT_PROVIDER_COOLDOWN_SECONDS=30

# AI service and model runtime.
DETECTION_MODEL=/app/models/best_v7_8n_100_640_16_SGD_0005.pt
DETECTION_CONFIDENCE=0.25
DETECTION_IMGSZ=640
MODEL_STATE_PATH=/app/state/active-model.json
IMAGE_MAX_BYTES=20971520
IMAGE_MAX_PIXELS=16000000
VIDEO_MAX_BYTES=104857600
VIDEO_MAX_DURATION_SECONDS=30
AI_SERVICE_TIMEOUT_SECONDS=30
AI_VIDEO_SERVICE_TIMEOUT_SECONDS=300
VIDEO_JOB_STALE_SECONDS=600

# User detection upload policy and quota.
USER_IMAGE_SOURCE_MAX_BYTES=20971520
USER_IMAGE_SOURCE_MAX_PIXELS=50000000
USER_IMAGE_NORMALIZED_MAX_EDGE=2560
USER_IMAGE_NORMALIZED_TARGET_BYTES=4194304
USER_IMAGE_NORMALIZED_HARD_MAX_BYTES=5242880
USER_VIDEO_MAX_BYTES=104857600
USER_VIDEO_MAX_DURATION_SECONDS=30
USER_VIDEO_MAX_SOURCE_EDGE=4096
USER_VIDEO_NORMALIZED_MAX_WIDTH=1920
USER_VIDEO_NORMALIZED_MAX_HEIGHT=1080
USER_VIDEO_NORMALIZED_MAX_FPS=30
USER_VIDEO_FFPROBE_TIMEOUT_SECONDS=20
USER_VIDEO_FFMPEG_TIMEOUT_SECONDS=180
USER_IMAGE_ROLLING_24H_LIMIT=50
USER_VIDEO_ROLLING_24H_LIMIT=5
USER_MEDIA_STORAGE_LIMIT_BYTES=1073741824
USER_ACTIVE_VIDEO_JOB_LIMIT=1

# Reverse proxy.
HTTP_PORT=80
