# local development default. In production, set APP_ENV=production and replace
# DATABASE_URL, JWT_SECRET_KEY, FRONTEND_URL, and AI_INTERNAL_API_KEY below.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# production must not use this local placeholder URL.
DATABASE_URL=postgresql+psycopg://flowlink_user:password@127.0.0.1:5432/flowlink

# production requires a non-default secret with at least 32 characters.
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=flowlink_access_token

ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT_ID=
ROBOFLOW_MODEL_VERSION=

UPLOAD_DIR=uploads
# optional: when all three values are set, public images are stored in Supabase Storage;
# when any value is missing, uploads fall back to local /uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# production must point at the deployed frontend origin, not localhost.
FRONTEND_URL=http://localhost:3000
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OAUTH_BACKEND_BASE_URL=http://localhost:8000

AI_SERVICE_URL=http://127.0.0.1:8001
# production requires the same non-public value as backend-ai/.env.
AI_INTERNAL_API_KEY=
AI_SERVICE_TIMEOUT_SECONDS=30
AI_VIDEO_SERVICE_TIMEOUT_SECONDS=120

CHAT_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
COPILOT_TIMEOUT_SECONDS=30
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
COPILOT_GUEST_RATE_LIMIT=10
COPILOT_USER_RATE_LIMIT=30
COPILOT_ADMIN_RATE_LIMIT=60
