# Copy this file to .env.lan on the LAN deployment host.
# Keep real values out of Git.

APP_ENV=production
COMPOSE_FILE=compose.yaml:compose.lan.yaml

# LAN users enter through http://mbc-sw.iptime.org:3202.
# If an external router forwards 3202 -> host 8100, keep HTTP_PORT=8100.
HTTP_PORT=8100

# Keep the canonical OAuth/redirect origin on DuckDNS HTTPS.
# Normal email/password login works through the LAN same-origin HTTP proxy.
FRONTEND_URL=https://flowlink-project.duckdns.org
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_OAUTH_BASE_URL=https://flowlink-project.duckdns.org
OAUTH_BACKEND_BASE_URL=https://flowlink-project.duckdns.org
ALLOWED_FRONTEND_ORIGINS=http://mbc-sw.iptime.org:3202,https://flowlink-project.duckdns.org
AUTH_INSECURE_HTTP_HOSTS=mbc-sw.iptime.org
# Docker-internal reverse-proxy IP from compose.lan.yaml, not the LAN host IP.
FORWARDED_ALLOW_IPS=172.30.0.10

# Frontend public browser keys.
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Backend application secrets.
JWT_SECRET_KEY=
AI_INTERNAL_API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=flowlink_access_token
DATABASE_URL=

# Optional Supabase Storage integration. Service role key must stay server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional integrations.
ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT_ID=
ROBOFLOW_MODEL_VERSION=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Copilot provider.
CHAT_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
COPILOT_TIMEOUT_SECONDS=30
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
COPILOT_GUEST_RATE_LIMIT=10
COPILOT_USER_RATE_LIMIT=30
COPILOT_ADMIN_RATE_LIMIT=60
COPILOT_MAX_OUTPUT_TOKENS=1200
COPILOT_PROVIDER_COOLDOWN_SECONDS=30

# AI service and model runtime.
DETECTION_MODEL=/app/models/best_v7_8n_100_640_16_SGD_0005.pt
DETECTION_CONFIDENCE=0.25
DETECTION_IMGSZ=640
MODEL_STATE_PATH=/app/state/active-model.json
IMAGE_MAX_BYTES=20971520
IMAGE_MAX_PIXELS=16000000
VIDEO_MAX_BYTES=104857600
VIDEO_MAX_DURATION_SECONDS=30
AI_SERVICE_TIMEOUT_SECONDS=30
AI_VIDEO_SERVICE_TIMEOUT_SECONDS=120
